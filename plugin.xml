<?xml version="1.0" encoding="UTF-8"?>
<plugin
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-plugin-voice-tools"
    version="0.2.0">
    <name>cordova-plugin-voice-tools</name>
    <description>Offline voice tool suite: keyword spotter, command spotter and FastConformer dictation</description>
    <license>MIT</license>
    <keywords>speech to text, keyword spotting, FastConformer, sherpa-onnx</keywords>
    <engines>
        <engine name="cordova-android" version=">=12.0.0" />
    </engines>

    <platform name="android">
        <js-module src="www/voice-tools.js" name="VoiceTools">
            <clobbers target="cordova.plugins.VoiceTools" />
        </js-module>

        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="VoiceTools">
                <param name="android-package" value="com.vayapedal.fastconformer.FastConformer" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.RECORD_AUDIO" />
            <uses-permission android:name="android.permission.INTERNET" />
        </config-file>

        <framework src="org.apache.commons:commons-compress:1.27.1" />
        <framework src="org.jetbrains.kotlin:kotlin-stdlib:1.9.24" />
        <framework src="src/android/fastconformer.gradle" custom="true" type="gradleReference" />

        <lib-file src="src/android/libs/sherpa-onnx-1.13.8.aar" />
        <resource-file src="src/android/proguard-sherpa.pro" target="proguard-sherpa.pro" />

        <source-file src="src/android/FastConformer.java" target-dir="src/com/vayapedal/fastconformer" />
        <source-file src="src/android/ModelStore.java" target-dir="src/com/vayapedal/fastconformer" />
        <source-file src="src/android/RecognizerEngine.java" target-dir="src/com/vayapedal/fastconformer" />
        <source-file src="src/android/SherpaBridge.java" target-dir="src/com/vayapedal/fastconformer" />
        <source-file src="src/android/KeywordEngine.java" target-dir="src/com/vayapedal/fastconformer" />
        <source-file src="src/android/TokenCapture.java" target-dir="src/com/vayapedal/fastconformer" />
    </platform>
</plugin>
